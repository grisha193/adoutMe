PORT=3000
SITE_OWNER_EMAIL=yourmail@yandex.ru

# SMTP for contact form emails
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=yourmail@yandex.ru
SMTP_PASS=app-password-from-yandex
SMTP_FROM="Developer Landing <yourmail@yandex.ru>"

# Optional AI helper via GigaChat
# Use either GIGACHAT_API_KEY or GIGACHAT_CLIENT_ID + GIGACHAT_CLIENT_SECRET.
GIGACHAT_API_KEY=
GIGACHAT_CLIENT_ID=
GIGACHAT_CLIENT_SECRET=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat-2

# Local dev only. Use true if Node.js shows SELF_SIGNED_CERT_IN_CHAIN for GigaChat.
GIGACHAT_IGNORE_TLS_ERRORS=false
